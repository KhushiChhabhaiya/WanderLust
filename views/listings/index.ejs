<% layout("/layouts/boilerplate") -%>
<div>
<div class="filter-wrapper">
  <button class="filter-arrow left-arrow" id="leftArrow" style= "margin-top: 1.5rem;"
    aria-label="Scroll categories left">
    <i class="fa-solid fa-chevron-left"></i>
  </button>

  <div id="filters">
    <a href="/listings/category/Trending">
      <div class="filter">
        <i class="fa-solid fa-fire"></i><br />
        Trending
      </div>
    </a>

    <a href="/listings/category/Rooms">
      <div class="filter">
        <i class="fa-solid fa-bed"></i><br />
        Rooms
      </div>
    </a>

    <a href="/listings/category/Iconic%20Cities">
      <div class="filter">
        <i class="fa-solid fa-mountain-city"></i><br />
        Iconic Cities
      </div>
    </a>

    <a href="/listings/category/Mountains">
      <div class="filter">
        <i class="fa-solid fa-mountain-sun"></i><br />
        Mountains
      </div>
    </a>

    <a href="/listings/category/Beach">
      <div class="filter">
        <i class="fa-solid fa-umbrella-beach"></i><br />
        Beach
      </div>
    </a>

    <a href="/listings/category/Amazing%20Pools">
      <div class="filter">
        <i class="fa-solid fa-person-swimming"></i><br />
        Amazing Pools
      </div>
    </a>

    <a href="/listings/category/Camping">
      <div class="filter">
        <i class="fa-solid fa-campground"></i><br />
        Camping
      </div>
    </a>

    <a href="/listings/category/Farms">
      <div class="filter">
        <i class="fa-solid fa-tractor"></i><br />
        Farms
      </div>
    </a>

    <a href="/listings/category/Arctic">
      <div class="filter">
        <i class="fa-solid fa-snowflake"></i><br />
        Arctic
      </div>
    </a>
  </div>

  <button class="filter-arrow right-arrow" id="rightArrow" style= "margin-top: 1.5rem;"
    aria-label="Scroll categories right">
    <i class="fa-solid fa-chevron-right"></i>
  </button>
  <div class="tax-toggle">
  <div class="form-check-reverse form-switch">
    <input
      class="form-check-input"
      type="checkbox"
      role="switch"
      id="switchCheckDefault"
    />
    <label class="form-check-label" for="switchCheckDefault">
      Display taxes
    </label>
  </div>
</div>
</div>


</div>


  <div class="row listing-row mt-4">
  <% for (let listing of allListings) { %>

      <div class="card col-12 col-sm-6 col-md-4 col-lg-3 listing-card">
        <a href="/listings/<%= listing._id %>">
          <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            alt="listing_image"
            style="height: 15rem;"
          />
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text mt-2" style="color: #222222;">
              <b ><%= listing.title %></b><br />
              &#8377; <%= listing.price.toLocaleString("en-IN") %> /Night
              <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </a>
      </div>

  <% } %>
  </div>


  <script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
      let taxInfo = document.getElementsByClassName("tax-info");
      for(info of taxInfo){
        if(info.style.display !="inline"){
          info.style.display="inline";
        }else{
          info.style.display="none";
        }
      }
    });

    
const filters = document.getElementById("filters");
const leftArrow = document.getElementById("leftArrow");
const rightArrow = document.getElementById("rightArrow");

leftArrow.addEventListener("click", () => {
  filters.scrollBy({
    left: -200,
    behavior: "smooth"
  });
});

rightArrow.addEventListener("click", () => {
  filters.scrollBy({
    left: 200,
    behavior: "smooth"
  });
});

  </script>