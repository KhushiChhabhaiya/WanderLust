<% layout("/layouts/boilerplate") -%>

<div class="row">
  <div class="col-8 offset-2 mt-3">
    <h3>Login on WanderLust</h3>
    <form action="/login" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          type="text"
          name="username"
          id="username"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control"
          required
        />
      </div>
      <button type="submit" class="btn btn-success">Login</button>
      <div class="mt-3">
        <a href="/auth/google" class="btn btn-outline-dark w-100">
          <i class="fa-brands fa-google"></i>
          Continue with Google
        </a>
      </div>
    </form>
  </div>
</div>

<div class="row mb-4">
  <div class="col-8 offset-2">
    <hr />
    <h5>Need a verification email?</h5>
    <p>Enter the email address you used to sign up and we will send a fresh link.</p>
    <form action="/resend-verification" method="post">
      <div class="input-group">
        <input
          type="email"
          name="email"
          class="form-control"
          placeholder="Email address"
          autocomplete="email"
          required
        />
        <button type="submit" class="btn btn-outline-success">Resend link</button>
      </div>
    </form>
  </div>
</div>
